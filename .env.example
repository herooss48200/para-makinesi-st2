# AGROS ST2 runtime identity (do not change)
AGROS_INSTANCE_ID=ST2
AGROS_APP_NAME=AGROS ST2
AGROS_REPO_SLUG=para-makinesi-st2
AGROS_PM2_NAME=agros-st2
AGROS_DATA_DIR=data
AGROS_LOG_DIR=logs-st2
AGROS_TELEGRAM_PREFIX=AGROS ST2

# Binance (ST2 must use its own credentials/environment)
BINANCE_API_KEY=buraya_st2_binance_api_key
BINANCE_API_SECRET=buraya_st2_binance_api_secret
BINANCE_BASE_URL=https://testnet.binancefuture.com

# Telegram (use a separate ST2 bot token or at minimum a clearly separated chat)
AGROS_ST2_TELEGRAM_TOKEN=buraya_st2_telegram_bot_token
AGROS_ST2_TELEGRAM_CHAT_ID=buraya_st2_telegram_chat_id
